# Environments
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Glass Box local state — all of this is regenerable from `glassbox init`
warehouse/
catalog.db
catalog.db-*
spool.db
spool.db-*
mlruns/
mlflow.db
scratch/

# Data (downloaded by `glassbox ingest`, never committed)
data/raw/
data/*.csv
data/*.parquet

# Demo scratch roots. `GLASSBOX_ROOT=gbdemo glassbox init` builds a complete
# throwaway root — data, warehouse, catalog — and every byte of it is
# regenerable, so none of it belongs in the repository.
gbdemo/
*/data/raw/

# Benchmarks / demo output
bench/results/*.json
demo/out/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
